{
  "name": "tanstack_start_ts",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/generate-sitemap.ts",
    "prebuild": "tsx scripts/generate-sitemap.ts",
    "dev": "vite",
    "build": "vite build && tsx scripts/check-no-backend-leaks.ts && tsx scripts/check-security.ts",
    "build:dev": "vite build --mode development && tsx scripts/check-no-backend-leaks.ts && tsx scripts/check-security.ts",
    "check:leaks": "tsx scripts/check-no-backend-leaks.ts",
    "check:security": "tsx scripts/check-security.ts",
    "build:prod": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server.js",
    "start": "npm run build:prod && node server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:dark": "bun scripts/check-dark-mode.ts",
    "cap:reset": "rimraf android ios && npm run build && npx cap add android && npx cap sync android && echo \"\\n✅ Clean Android project ready. Open in Android Studio: npx cap open android\"",
    "android:clean-rebuild": "npm install && npm run cap:reset && npx cap open android",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
