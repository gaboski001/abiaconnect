{
  "appId": "com.abiaconnect.app",
  "appName": "abiaconnect",
  "webDir": "dist",
  "server": {
    "url": "https://abiaconnect.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "abiaconnect.com",
      "*.abiaconnect.com",
      "*.lovable.app",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
