{
	"appId": "com.abiaconnect.app",
	"appName": "abiaconnect",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"abiaconnect.com",
			"*.abiaconnect.com",
			"*.lovable.app",
			"*.supabase.co"
		]
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
