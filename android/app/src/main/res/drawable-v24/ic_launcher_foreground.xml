<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stylized Abia Mark centered in 66dp safe zone -->
    <group
        android:translateX="54"
        android:translateY="54">

        <group
            android:translateX="-24"
            android:translateY="-24">

            <!-- Shadow for depth -->
            <path
                android:pathData="M24,4 L4,44 L24,38 L44,44 Z"
                android:fillColor="#000000"
                android:fillAlpha="0.2"
                android:translateY="1.5"/>

            <!-- Main Mark -->
            <path
                android:pathData="M24,4 L4,44 L24,38 L44,44 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="4"
                        android:startY="4"
                        android:endX="44"
                        android:endY="44"
                        android:type="linear">
                        <item android:color="#E87015" android:offset="0" />
                        <item android:color="#F8C301" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Gloss highlight -->
            <path
                android:pathData="M24,6 L6,42 L24,36 L42,42 Z"
                android:strokeWidth="0.5"
                android:strokeColor="#FFFFFF"
                android:strokeAlpha="0.3"/>

        </group>
    </group>
</vector>
