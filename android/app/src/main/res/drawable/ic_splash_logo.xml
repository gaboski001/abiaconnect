<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Outer Glow / Depth Shadow -->
    <path
        android:pathData="M144,144m-125,0a125,125 0,1 1,250 0a125,125 0,1 1,-250 0"
        android:fillAlpha="0.15">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="144"
                android:centerY="144"
                android:gradientRadius="125"
                android:type="radial">
                <item android:color="#1CA9D9" android:offset="0" />
                <item android:color="#00000000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Branding Ring -->
    <path
        android:pathData="M144,144m-110,0a110,110 0,1 1,220 0a110,110 0,1 1,-220 0"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="34"
                android:endX="254"
                android:endY="254"
                android:type="linear">
                <item android:color="#FFD65A" android:offset="0" />
                <item android:color="#1CA9D9" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Logo Group for Animation -->
    <group
        android:name="logo_group"
        android:pivotX="144"
        android:pivotY="144">

        <!-- Bottom Shadow for 3D depth -->
        <path
            android:pathData="M144,80 L80,200 L144,180 L208,200 Z"
            android:fillColor="#000000"
            android:fillAlpha="0.2"
            android:translateY="4"/>

        <!-- Main Logo Mark (Stylized A) -->
        <path
            android:pathData="M144,80 L80,200 L144,180 L208,200 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="80"
                    android:startY="80"
                    android:endX="208"
                    android:endY="200"
                    android:type="linear">
                    <item android:color="#E87015" android:offset="0" />
                    <item android:color="#F8C301" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Highlight Sweep -->
        <path
            android:pathData="M144,80 L110,140 L144,130 L178,140 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.25"/>

        <!-- Gloss Highlight -->
        <path
            android:pathData="M144,85 L85,195 L144,175 L203,195 Z"
            android:strokeWidth="0.5"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.3"/>

    </group>

</vector>
